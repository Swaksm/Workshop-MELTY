# backend : lit les capteurs et la vision de toutes les tables, envoie les commandes
user backend
topic read sentinelx/+/sensors
topic read sentinelx/+/vision
topic write sentinelx/+/cmd

# esp32 : publie ses mesures, reçoit les commandes du buzzer
user esp32
topic write sentinelx/table1/sensors
topic read sentinelx/table1/cmd

# vision : publie les détections de la webcam
user vision
topic write sentinelx/table1/vision
