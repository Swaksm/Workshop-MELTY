POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel
DATABASE_URL=postgresql+psycopg://sentinel:change-me@db:5432/sentinel
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=backend
MQTT_PASSWORD=change-me
# IP du PC sur le Wi-Fi de l'ecole, mise a jour par lancer.ps1 a chaque lancement
SERVER_IP=10.0.3.173
VISION_MQTT_PASSWORD=change-me
ESP32_MQTT_PASSWORD=change-me
# Retention (MCO) : mesures et clips plus vieux sont purges toutes les heures
RETENTION_MESURES_JOURS=7
RETENTION_CLIPS_JOURS=3
MEDIA_MAX_MO=500
# Authentification de l'API et du dashboard (generes par lancer.ps1 si absents)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me
# Nombre de postes autorises a ouvrir le dashboard (un certificat client par poste)
NB_CLIENTS=5
